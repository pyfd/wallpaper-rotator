# >>> wallpaper-rotator >>>  (managed block — do not edit by hand; re-run install.sh)
# Every 10 min: fetch a fresh wallpaper into the pool (multi-source + fallback; fetch-wallpaper.sh logs ok/miss/fail to @@LOG@@).
*/10 * * * * @@FETCH@@ >/dev/null 2>&1
# Hourly: keep only the 30 newest images in the pool; log how many were pruned.
5 * * * * N=$(ls -tp @@POOL@@/*.jpg 2>/dev/null | tail -n +31 | wc -l); ls -tp @@POOL@@/*.jpg 2>/dev/null | tail -n +31 | xargs -r rm --; [ "$N" -gt 0 ] && echo "$(date '+\%F \%T') [prune] removed=$N" >> @@LOG@@
# Every 10 min (offset): rotate the desktop wallpaper to a random pool image (DE-aware; logs internally to @@LOG@@).
3-59/10 * * * * @@SETWP@@ >/dev/null 2>&1
# Every 10 min (offset): refresh the status page for the local web UI (wallpaper-web).
7-59/10 * * * * @@GENSTATUS@@ >/dev/null 2>&1
# <<< wallpaper-rotator <<<
