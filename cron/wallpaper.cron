# >>> wallpaper-rotator >>>  (managed block — do not edit by hand; re-run install.sh)
# Every 10 min: fetch a fresh wallpaper into the pool (multi-source + fallback; fetch-wallpaper.sh logs ok/miss/fail to @@LOG@@).
*/10 * * * * @@FETCH@@ >/dev/null 2>&1
# Hourly: keep only the POOL_MAX newest images in the pool (favourites/ excluded — it's a subdir the globs don't match); log how many were pruned. POOL_MAX read live from the config (default 5000 ≈ 2+ months no-repeat at a 10-min rotation); raise it for longer cycles, lower to reclaim disk.
5 * * * * M=$(grep -oP "^POOL_MAX='?\K[0-9]+" @@CONFIG@@ 2>/dev/null); M=${M:-5000}; K=$((M+1)); N=$(ls -tp @@POOL@@/*.jpg @@POOL@@/*.jpeg @@POOL@@/*.png 2>/dev/null | tail -n +$K | wc -l); ls -tp @@POOL@@/*.jpg @@POOL@@/*.jpeg @@POOL@@/*.png 2>/dev/null | tail -n +$K | xargs -r rm --; [ "$N" -gt 0 ] && echo "$(date '+\%F \%T') [prune] removed=$N" >> @@LOG@@
# Every @@INTERVAL@@ min: rotate the desktop wallpaper to a random pool image (DE-aware; logs internally to @@LOG@@). Interval set via the web UI.
*/@@INTERVAL@@ * * * * @@SETWP@@ >/dev/null 2>&1
# Every 1 min: when the clock overlay is on, re-render the CURRENT image (no shuffle) so the baked-in clock (and weather/stats) stay current. No-op when the clock is off.
# (grep matches OVERLAY_CLOCK='1' or ="1" or =1 — the web server switched the config to single-quote escaping 2026-06-04 and the old ="1"-only match silently killed this refresh.)
* * * * * grep -qE '^OVERLAY_CLOCK=.?1' @@CONFIG@@ 2>/dev/null && [ -s @@CURRENT@@ ] && @@SETWP@@ "$(cat @@CURRENT@@)" >/dev/null 2>&1
# Every 10 min (offset): refresh the status page for the local web UI (wallpaper-web).
7-59/10 * * * * @@GENSTATUS@@ >/dev/null 2>&1
# Every 1 min: poll the infra-alerts endpoint (no-op unless ALERTS_URL is set in the config). Re-renders the current image when the active alert set changes, so a critical-alert badge appears within ~60s.
* * * * * @@CHECKALERTS@@ >/dev/null 2>&1
# Daily: refresh the quote cache from the quotes API (so overlay quotes keep changing).
17 4 * * * @@FETCHQ@@ >/dev/null 2>&1
# <<< wallpaper-rotator <<<
